# ---- App ----
APP_NAME=Prospex
ENV=development

# ---- Security ----
# Change this to a long random string in production
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database ----
# SQLite (local dev):
DATABASE_URL=sqlite:///./leads.db
# PostgreSQL (production — e.g. Supabase/Neon):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---- AI / LLM provider (any one is enough) ----
# The platform supports multiple providers. Set the credentials for at least
# one of the following blocks. Without any, the built-in deterministic engine
# is used (app still works, just with template explanations).

# Option 1: OpenAI (needs billing credits)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: route OpenAI SDK to another OpenAI-compatible endpoint.
# Examples: Ollama local (http://localhost:11434/v1), Groq, OpenRouter, vLLM.
# Leave empty to use api.openai.com directly.
OPENAI_BASE_URL=

# Option 2: Google Gemini (has a free tier — key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Option 3: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Third-party data sources (optional) ----
# Set real keys to hit live APIs. Without them, adapters fall back to simulation.
HUNTER_API_KEY=
CLEARBIT_API_KEY=

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]